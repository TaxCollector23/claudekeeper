{
  "name": "claudekeeper",
  "version": "0.1.0",
  "description": "Local supervisor for Claude Code — keeps sessions running and the Mac awake.",
  "type": "module",
  "bin": {
    "claudekeeper": "./bin/claudekeeper.mjs"
  },
  "scripts": {
    "daemon": "tsx src/daemon/index.ts",
    "cli": "tsx src/cli/index.ts",
    "dashboard:dev": "vite --config src/dashboard/vite.config.ts",
    "dashboard:build": "vite build --config src/dashboard/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && npm run dashboard:build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/daemon/index.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8",
    "open": "^10.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
