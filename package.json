{
  "name": "@rangan23/claudekeeper",
  "version": "0.9.2",
  "description": "Keep your Mac awake so Claude Code keeps working while you're away. No admin needed.",
  "type": "module",
  "license": "MIT",
  "author": "ClaudeKeeper Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/TaxCollector23/claudekeeper.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "supervisor",
    "macos"
  ],
  "bin": {
    "claudekeeper": "./bin/claudekeeper.mjs"
  },
  "files": [
    "dist",
    "dist-dashboard",
    "bin",
    "launchd",
    "native/build",
    "native/ClaudeKeeperPower",
    "scripts/install.sh",
    "scripts/uninstall.sh",
    "scripts/build-native.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "daemon": "tsx src/daemon/index.ts",
    "cli": "tsx src/cli/index.ts",
    "dashboard:dev": "vite --config src/dashboard/vite.config.ts",
    "dashboard:build": "vite build --config src/dashboard/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && npm run dashboard:build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/daemon/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "commander": "^12.1.0",
    "fastify": "^4.28.1",
    "nanoid": "^5.0.7",
    "open": "^10.1.0",
    "picocolors": "^1.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
